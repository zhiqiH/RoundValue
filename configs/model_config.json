{
  "schema_version": "1.0",
  "default_model_id": "deepseek_flash",
  "providers": {
    "deepseek": {
      "adapter": "openai_compatible",
      "base_url": "https://api.deepseek.com",
      "api_key": {
        "environment_variable": "DEEPSEEK_API_KEY",
        "file": ".secret/model_key.json",
        "field": "deepseek.api_key"
      },
      "timeout_seconds": 300,
      "max_attempts": 3,
      "retry_backoff_seconds": 1.0,
      "supports_thinking_toggle": true,
      "max_output_tokens_field": "max_tokens"
    },
    "openai": {
      "adapter": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key": {
        "environment_variable": "OPENAI_API_KEY",
        "file": ".secret/model_key.json",
        "field": "openai.api_key"
      },
      "timeout_seconds": 300,
      "max_attempts": 3,
      "retry_backoff_seconds": 1.0,
      "supports_thinking_toggle": false,
      "max_output_tokens_field": "max_completion_tokens"
    }
  },
  "models": {
    "deepseek_flash": {
      "provider": "deepseek",
      "model_name": "deepseek-v4-flash",
      "temperature": 0.3,
      "reasoning": {
        "enabled": false,
        "effort": "high"
      },
      "max_output_tokens": 32768,
      "request_defaults": {
        "response_format": {
          "type": "json_object"
        }
      },
      "pricing": {
        "currency": "USD",
        "input_cache_hit_per_million": 0.0028,
        "input_cache_miss_per_million": 0.14,
        "output_per_million": 0.28,
        "effective_date": "2026-08-13"
      }
    },
    "gpt5_nano": {
      "provider": "openai",
      "model_name": "gpt-5-nano",
      "temperature": 1.0,
      "reasoning": {
        "enabled": true,
        "effort": "medium"
      },
      "max_output_tokens": 32768,
      "request_defaults": {
        "response_format": {
          "type": "json_object"
        }
      },
      "pricing": {
        "currency": "USD",
        "input_cache_hit_per_million": 0.005,
        "input_cache_miss_per_million": 0.05,
        "output_per_million": 0.4,
        "effective_date": "2026-08-16"
      }
    },
    "gpt4o_mini": {
      "provider": "openai",
      "model_name": "gpt-4o-mini-2024-07-18",
      "temperature": 0,
      "reasoning": {
        "enabled": false
      },
      "max_output_tokens": 2048,
      "request_defaults": {
        "response_format": {
          "type": "json_object"
        }
      },
      "pricing": {
        "currency": "USD",
        "input_cache_hit_per_million": 0.075,
        "input_cache_miss_per_million": 0.15,
        "output_per_million": 0.6,
        "effective_date": "2026-08-16"
      }
    }
  }
}
