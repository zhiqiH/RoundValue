{
  "schema_version": "1.0",
  "default_model_id": "deepseek_flash",
  "providers": {
    "deepseek": {
      "adapter": "openai_compatible",
      "base_url": "https://api.deepseek.com",
      "api_key": {
        "environment_variable": "DEEPSEEK_API_KEY",
        "file": ".secret/model_key.json",
        "field": "deepseek.api_key"
      },
      "timeout_seconds": 120,
      "max_attempts": 3,
      "retry_backoff_seconds": 1.0
    }
  },
  "models": {
    "deepseek_flash": {
      "provider": "deepseek",
      "model_name": "deepseek-v4-flash",
      "temperature": 0.0,
      "reasoning": {
        "enabled": false
      },
      "max_output_tokens": 2048,
      "request_defaults": {
        "response_format": {
          "type": "json_object"
        }
      },
      "pricing": {
        "currency": "USD",
        "input_cache_hit_per_million": 0.0028,
        "input_cache_miss_per_million": 0.14,
        "output_per_million": 0.28,
        "effective_date": "2026-08-13"
      }
    }
  }
}
